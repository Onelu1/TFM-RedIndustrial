+/* =====================================================================
+ * TFM UID ACL - inicio
+ * Valida el Unit Identifier (byte 6 del MBAP) de Modbus TCP contra el
+ * fichero /etc/openplc/acl.conf.  Si el fichero no existe o no define
+ * expected_uid, el comportamiento es el original (no se filtra el UID).
+ * Añadido por TFM, parche uid_acl.patch.
+ * ===================================================================== */
+#include <errno.h>
+#include <ctype.h>
+
+static int tfm_uid_acl_cached = -2;  /* -2=sin leer, -1=desactivado, >=0=UID */
+
+static int tfm_load_expected_uid(void)
+{
+    FILE *f = fopen("/etc/openplc/acl.conf", "r");
+    if (f == NULL) return -1;
+
+    char line[256];
+    int result = -1;
+    while (fgets(line, sizeof(line), f) != NULL)
+    {
+        char *p = line;
+        while (*p && isspace((unsigned char)*p)) p++;
+        if (*p == '#' || *p == '\0') continue;
+        if (strncmp(p, "expected_uid", 12) != 0) continue;
+        p += 12;
+        while (*p && (isspace((unsigned char)*p) || *p == '=')) p++;
+        char *end;
+        long v = strtol(p, &end, 10);
+        if (end != p && v >= 0 && v <= 255)
+        {
+            result = (int)v;
+            break;
+        }
+    }
+    fclose(f);
+    return result;
+}
+
+static int tfm_get_expected_uid(void)
+{
+    int cached = tfm_uid_acl_cached;
+    if (cached != -2) return cached;
+    int v = tfm_load_expected_uid();
+    tfm_uid_acl_cached = v;
+    if (v >= 0)
+        printf("[TFM-ACL] Modbus UID exigido = %d (de /etc/openplc/acl.conf)\n", v);
+    else
+        printf("[TFM-ACL] /etc/openplc/acl.conf ausente o sin expected_uid - UID no filtrado\n");
+    fflush(stdout);
+    return v;
+}
+/* =====================================================================
+ * TFM UID ACL - fin
+ * ===================================================================== */
+
